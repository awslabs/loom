# Copy to .env at the repo root. .env is gitignored.
# LOCAL DEVELOPMENT ONLY.

# LiteLLM proxy master key — must match docker-compose LITELLM_MASTER_KEY / LOOM_LITELLM_PROXY_API_KEY.
LITELLM_MASTER_KEY=sk-loom-local-dev

# Cursor adapter (compose service cursor-adapter). Never set these on the Loom backend.
# Get a user key at https://cursor.com/dashboard/integrations
# Without CURSOR_API_KEY the adapter still starts; completions return 401.
CURSOR_API_KEY=
# Host path mounted into the adapter as /workspace. Empty = this repository.
CURSOR_WORKSPACE=
CURSOR_MODEL=composer-2.5
